# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Secrets and local settings
.env
!.env.example

# Data, models, and generated artifacts
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
models/*
!models/.gitkeep

# Generated experiment runs and temp files are ignored, but research tables and protocols are preserved
artifacts/*
!artifacts/.gitkeep
!artifacts/research_tables/
!artifacts/research_figures/
!artifacts/experimental_design/
!artifacts/model_registry/
!artifacts/governance/

# Notebooks
.ipynb_checkpoints/

# Node / frontend
node_modules/
product/frontend/dist/
*.local

# Python tooling caches
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Local runtime state
*.log
*.sqlite3
mlruns/
.env.local
