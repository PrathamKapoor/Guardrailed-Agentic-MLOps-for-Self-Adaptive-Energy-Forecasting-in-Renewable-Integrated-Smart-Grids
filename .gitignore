# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Secrets and local settings
.env
!.env.example

# Raw and large external archives are ignored
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/external/*
!data/external/.gitkeep
models/*
!models/.gitkeep

# Processed canonical hourly parquets and features are tracked for reproducibility and CI testing

# Ephemeral test directories and local tracking databases are ignored
artifacts/test_tmp/*
!artifacts/test_tmp/.gitkeep
artifacts/mlflow/*.db
artifacts/mlflow/*.sqlite
artifacts/mlflow/*.sqlite3

# Notebooks
.ipynb_checkpoints/

# Node / frontend
node_modules/
product/frontend/dist/
*.local

# Python tooling caches
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Local runtime state
*.log
*.sqlite3
mlruns/
.env.local
