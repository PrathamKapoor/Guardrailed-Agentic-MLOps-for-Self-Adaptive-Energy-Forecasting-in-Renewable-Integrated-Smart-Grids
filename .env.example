# Guardrailed Agentic MLOps — environment configuration
#
# All variables are non-secret deployment-level knobs. Nothing in this
# project accepts LLM / quantum / cloud credentials; if you find yourself
# adding OPENAI_API_KEY or QISKIT_TOKEN here, that is a project-scope
# violation.
#
# Copy this file to ".env" and edit. ".env" is git-ignored. The backend
# reads these on import; uvicorn should be started with the same
# environment, e.g.:
#
#   .venv\Scripts\python.exe -m uvicorn product.backend_api.app.main:app --host 0.0.0.0 --port 8000
#
# ---------------------------------------------------------------------------
# Project root resolution
# ---------------------------------------------------------------------------
# Override the resolved project root when the API process is started outside
# the repository checkout (read-only mount, packaged distribution, CI).
# Default (unset): 3 directories up from product/backend_api/app/config.py.
# SMARTGRID_MLOPS_PROJECT_ROOT=C:/path/to/checkout

# ---------------------------------------------------------------------------
# CORS allowed origins
# ---------------------------------------------------------------------------
# Comma-separated list of origins allowed by the CORS middleware. The dev
# default (when this is unset) is the Vite dev server origin
# (http://127.0.0.1:5173). Production deployments MUST set this explicitly
# to the origin that serves the built frontend. The configuration layer
# logs a warning when SMARTGRID_MLOPS_APP_ENV=production but the allow-list is
# unset, so the operator sees the risk.
# SMARTGRID_MLOPS_ALLOWED_ORIGINS=https://app.example.com

# ---------------------------------------------------------------------------
# Application environment
# ---------------------------------------------------------------------------
# Either "development" (default) or "production". Controls the CORS default,
# the verbosity of the typed error envelope on unhandled exceptions, and
# the severity of the startup artefact check (the artefact check is always
# fatal when artefacts are missing; the CORS warning is logged once).
# SMARTGRID_MLOPS_APP_ENV=development

# ---------------------------------------------------------------------------
# Frontend → backend wiring (Vite build-time substitution)
# ---------------------------------------------------------------------------
# At build time, the frontend reads VITE_API_BASE_URL and uses it as the
# base URL for every API request. When unset, the relative path "/api" is
# used (works with the Vite dev server proxy and with a single-origin
# production deployment). Never point this at an untrusted origin.
# VITE_API_BASE_URL=https://api.example.com
